#!/bin/sh
# Build and run the native fixture tests. No Axe-Edit or hardware needed.
set -eu
ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
OUT="$ROOT/.local/test-bin"
mkdir -p "$OUT"
cd "$ROOT"
INC="-Isrc/agent -Isrc/editor -Isrc/ui -Isrc/audio"
CXX="xcrun clang++ -std=c++17 -fobjc-arc -fblocks -framework Cocoa -framework AVFoundation -framework Accelerate -framework CoreMedia -framework UniformTypeIdentifiers $INC"
AUDIO="src/audio/AudioAnalysis.mm src/audio/AudioClips.mm src/audio/AudioTools.mm"
CORE="src/editor/EditorTools.mm src/editor/NativeBridge.mm $AUDIO"

run() { name="$1"; shift; echo "== $name"; "$@" -o "$OUT/$name"; "$OUT/$name"; }

run chat-dock      xcrun clang -fobjc-arc -fblocks -framework Cocoa $INC tests/ChatDockTest.m
run editor-tools   $CXX tests/EditorToolsTest.mm $CORE
run mcp-server     $CXX tests/MCPServerTest.mm src/agent/MCPServer.mm $CORE
run chat-agent     $CXX tests/ChatAgentTest.mm src/agent/MCPServer.mm $CORE
run chat-panel     $CXX tests/ChatPanelTest.mm src/agent/ChatAgent.mm src/agent/MCPServer.mm src/ui/AudioStrip.mm src/audio/AudioRecorder.mm $CORE
run audio-analysis $CXX tests/AudioAnalysisTest.mm src/audio/AudioAnalysis.mm
run audio-tools    $CXX tests/AudioToolsTest.mm $CORE
run bridge-calibration $CXX tests/BridgeCalibrationTest.mm $CORE
echo "== discovery"; python3 -I tests/test_discovery.py
echo "All native tests passed."
