#!/bin/sh
# Build and run the native fixture tests. No Axe-Edit or hardware needed.
set -eu
ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
OUT="$ROOT/.local/test-bin"
mkdir -p "$OUT"
cd "$ROOT"
INC="-Isrc/agent -Isrc/editor -Isrc/ui"
CXX="xcrun clang++ -std=c++17 -fobjc-arc -fblocks -framework Cocoa $INC"
CORE="src/editor/EditorTools.mm src/editor/NativeBridge.mm"

run() { name="$1"; shift; echo "== $name"; "$@" -o "$OUT/$name"; "$OUT/$name"; }

run chat-dock      xcrun clang -fobjc-arc -fblocks -framework Cocoa $INC tests/ChatDockTest.m
run editor-tools   $CXX tests/EditorToolsTest.mm $CORE
run mcp-server     $CXX tests/MCPServerTest.mm src/agent/MCPServer.mm $CORE
run chat-agent     $CXX tests/ChatAgentTest.mm src/agent/MCPServer.mm $CORE
run chat-panel     $CXX tests/ChatPanelTest.mm src/agent/ChatAgent.mm src/agent/MCPServer.mm $CORE
echo "All native tests passed."
